# ["NEGATIVE MARKING"]->TC=O(n) & SC=O(1).
def findDuplicates(self, nums: List[int]) -> List[int]:
        ans=[]
        for num in nums:
            index=abs(num)-1
            if nums[index]<0:
                ans.append(abs(num))
            else:
                nums[index]*=-1
        return ans 


#["CYCLE SORT"]->TC=O(n) & SC=O(1).
def findDuplicates(self, nums: List[int]) -> List[int]:
        i=0
        while i<len(nums):
            current=nums[i]-1
            if nums[current]!=nums[i]:
                nums[current],nums[i]=nums[i],nums[current]
            else:
                i+=1
        ans=[]
        for i in range(len(nums)):
            if nums[i]!=i+1:
                ans.append(nums[i])
        return ans 


#["MY CODE"]->TC=O(n) & SC=O(n).
rom collections import Counter
class Solution:
    def findDuplicates(self, nums: List[int]) -> List[int]:
        nums.sort()
        ans=[]
        count=Counter(nums)
        for key,value in count.items():
            if value==2:
                ans.append(key)
        return ans 


