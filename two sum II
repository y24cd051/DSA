# ["TWO POINTERS"].->TC=O(n),SC=O(1).
class Solution:
    def twoSum(self, numbers: List[int], target: int) -> List[int]:
        n=len(numbers)
        i=0
        j=n-1
        while i<j:
            sum=numbers[i]+numbers[j]
            if sum>target:
                j-=1
            elif sum<target:
                i+=1
            else:
                return [i+1,j+1]


#["USING DICTINORY{}"].->TC=O(n),SC=O(n).
class Solution:
    def twoSum(self, numbers: List[int], target: int) -> List[int]:
        n=len(numbers)
        d={} 
        for i,num in enumerate(numbers):
            diff=target-num
            if diff not in d:
                d[num]=i+1
            else:
                return [d[diff],i+1]
